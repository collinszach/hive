# ============================================================
# Hive Finance Platform — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env — it contains secrets.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=finance
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_HOST=127.0.0.1   # overridden per-service in docker-compose.yml

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ---- Plaid (get from dashboard.plaid.com → Developers → Keys) ----
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_production_secret
PLAID_ENV=production
# Optional: URL for Plaid to POST transaction webhooks (needs public URL or ngrok)
PLAID_WEBHOOK_URL=
# Required for OAuth banks (Capital One, Chase, Wells Fargo, Amex, etc.)
# Must exactly match a URI registered in: Plaid dashboard → Team Settings → API → Allowed redirect URIs
# Example: http://localhost:8080/connect  OR  http://your-nuc-tailscale-hostname/connect
PLAID_REDIRECT_URI=http://localhost:8080/connect

# ---- Anthropic (get from console.anthropic.com/settings/keys) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Ollama (runs on NUC host, not in Docker) ----
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ---- SnapTrade (optional — for investment accounts) ----
# Get from dashboard.snaptrade.com
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ---- App ----
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_char_hex_string
LOG_LEVEL=INFO
# Shared secret between Next.js proxy and FastAPI — never sent to the browser
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace_with_64_char_hex_string

# ---- Auth (username/password via NextAuth.js credentials) ----
# Used to seed the admin user — run: docker compose exec backend python scripts/create_admin.py
# Password is hashed with bcrypt before storage; these vars are only read by the seed script
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme_strong_password_here_min_12_chars
# Server-side URL for Next.js to reach FastAPI (never exposed to browser)
BACKEND_URL=http://127.0.0.1:8000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace_with_64_char_hex_string
# Must match the URL you access the app on (no trailing slash)
NEXTAUTH_URL=http://localhost:8080
# Tighten CORS — set to your actual frontend URL
FRONTEND_URL=http://127.0.0.1:3000
# After seeding the admin user, AUTH_PASSWORD can be removed from .env if desired
# (it's only read by the seed script, not by the running app)

# ---- Frontend ----
# Used by Next.js server-side API calls (inside Docker network)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Used by browser for direct API calls (set to NUC Tailscale hostname if needed)
NEXT_PUBLIC_EXTERNAL_API_URL=

# ---- Optional Notifications ----
# Slack webhook for budget alerts
SLACK_WEBHOOK_URL=
# ntfy.sh push notifications (self-hosted or ntfy.sh)
NTFY_URL=
NTFY_TOPIC=finance-alerts
