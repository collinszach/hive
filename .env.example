# ============================================================
# Hive Finance Platform — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env — it contains secrets.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=finance
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_HOST=127.0.0.1   # overridden per-service in docker-compose.yml

# ---- Redis ----
# Include the password in the URL. Port 6380 is used to avoid conflicts with host Redis.
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6380/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@127.0.0.1:6380/1

# ---- Plaid (get from dashboard.plaid.com → Developers → Keys) ----
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_production_secret
PLAID_ENV=production
# Optional: URL for Plaid to POST transaction webhooks (needs public URL or ngrok)
PLAID_WEBHOOK_URL=
# Required for OAuth banks (Capital One, Chase, Wells Fargo, Amex, etc.)
# Must exactly match a URI registered in: Plaid dashboard → Team Settings → API → Allowed redirect URIs
# Example: http://localhost:8080/connect  OR  http://your-nuc-tailscale-hostname/connect
PLAID_REDIRECT_URI=http://localhost:8080/connect
# Webhook verification secret — REQUIRED. Webhook rejects all requests if unset.
# Set to any long random string; use the same value in your Plaid dashboard webhook config.
# Generate: openssl rand -hex 32
PLAID_WEBHOOK_SECRET=replace_with_strong_secret

# ---- Anthropic (get from console.anthropic.com/settings/keys) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Ollama (runs on NUC host, not in Docker) ----
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2          # used for transaction categorization (stage 2)
OLLAMA_CHAT_MODEL=qwen2.5:7b   # used for AI chat (better instruction following)

# ---- SnapTrade (optional — for investment accounts) ----
# Get from dashboard.snaptrade.com
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ---- Encryption ----
# Fernet key for encrypting Plaid access tokens at rest — REQUIRED.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_with_fernet_key

# ---- App ----
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_char_hex_string
# Seed admin account — auto-created on startup if no users exist.
# Change your password via the UI after first login; this env var is only used for initial seeding.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
LOG_LEVEL=INFO
# Set to true when serving over HTTPS — required for Vercel or any public deployment
COOKIE_SECURE=true
# Comma-separated list of allowed CORS origins. Must include your frontend URL.
# For Vercel: ALLOWED_ORIGINS=https://hive.zacharyjcollins.com
ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Used by Next.js server-side API calls (inside Docker network)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Used by browser for direct API calls (set to NUC Tailscale hostname if needed)
NEXT_PUBLIC_EXTERNAL_API_URL=

# ---- Optional Notifications ----
# Slack webhook for budget alerts
SLACK_WEBHOOK_URL=
# ntfy.sh push notifications (self-hosted or ntfy.sh)
NTFY_URL=
NTFY_TOPIC=finance-alerts

# ---- Stripe (get from dashboard.stripe.com) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
